{
	# Nothing uses the admin API: do not listen on localhost:2019.
	admin off
	servers {
		# The public edge proxy sanitizes X-Forwarded-For before it reaches us.
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"

		# The API sets these four itself: a default leaves its answer with
		# one value each instead of two, and still covers the static files.
		?Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
	}

	respond /healthz 200

	handle /api/* {
		request_body {
			max_size 101MB
		}
		reverse_proxy open-quiz-backend:8000 {
			transport http {
				dial_timeout 2s
				# docs/nginx.conf waits as long on /api/question-banks/.
				response_header_timeout 150s
			}
		}
	}

	# Hashed names: a new build never reuses one.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Versioned directory (scripts/copy-pyodide.mjs): a Pyodide update
	# changes the path, so the loader and its runtime never mix.
	handle /pyodide/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /locales/* {
		header Cache-Control "no-cache"
		file_server
	}

	# Any other path with an extension is a file: a missing one is a 404,
	# not the application page.
	@files {
		path_regexp \.[^/]+$
		not path /index.html
	}
	handle @files {
		file_server
	}

	# Every page of the application is index.html. Always revalidated: after
	# an update, a cached copy would point at scripts that no longer exist.
	handle {
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex"
		rewrite * /index.html
		file_server
	}
}
