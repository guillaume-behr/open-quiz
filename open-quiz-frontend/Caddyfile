{
    servers {
        # The public edge proxy sanitizes X-Forwarded-For before it reaches us.
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}

:8080 {
    root * /srv
    encode zstd gzip

    header {
        -Server
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' {env.API_ORIGIN}; manifest-src 'self'"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    respond /healthz 200

    handle /api/* {
        request_body {
            max_size 101MB
        }
        reverse_proxy open-quiz-backend:8000 {
            transport http {
                dial_timeout 2s
                response_header_timeout 150s
            }
        }
    }

    @immutable_assets path /assets/*
    header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

    @fresh_content path / /index.html /locales/*
    header @fresh_content Cache-Control "no-cache"

    handle /assets/* {
        file_server
    }

    @theme_favicon path /theme-init.js /favicon.svg
    handle @theme_favicon {
        file_server
    }

    @locales_pyodide path /locales/* /pyodide/*
    handle @locales_pyodide {
        file_server
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
