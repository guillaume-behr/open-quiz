{
    "name": "open-quiz-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.15.1",
    "scripts": {
        "dev": "node scripts/copy-pyodide.mjs && vite",
        "build": "node scripts/copy-pyodide.mjs && tsc -b && vite build",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"public/locales/*/translation.json\" \"*.{js,json,ts}\" \"index.html\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"public/locales/*/translation.json\" \"*.{js,json,ts}\" \"index.html\"",
        "test": "node scripts/check-locales.mjs && node scripts/check-class-labels.mjs && node scripts/check-error-codes.mjs && vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "typecheck": "tsc -b --pretty false",
        "preview": "vite preview"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-arabic": "^5.3.0",
        "@fontsource-variable/noto-sans-sc": "^5.3.1",
        "@tailwindcss/vite": "^4.3.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.7.2",
        "i18next-browser-languagedetector": "^8.3.0",
        "i18next-http-backend": "^4.0.10",
        "lucide-react": "^1.69.0",
        "prism-react-renderer": "^2.4.1",
        "pyodide": "314.0.7",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.13",
        "react-router": "^8.5.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.4",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@playwright/test": "^1.65.0",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6",
        "eslint": "^10",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17",
        "jsdom": "^30.1.3",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "~6",
        "typescript-eslint": "^8",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
