{
    "name": "open-quiz-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node scripts/copy-pyodide.mjs && vite",
        "build": "node scripts/copy-pyodide.mjs && tsc -b && vite build",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"public/locales/*/translation.json\" \"*.{js,json,ts}\" \"index.html\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"public/locales/*/translation.json\" \"*.{js,json,ts}\" \"index.html\"",
        "test:coverage": "pnpm test --coverage",
        "test": "node scripts/check-locales.mjs && node scripts/check-class-labels.mjs && node scripts/check-error-codes.mjs && vitest run",
        "test:e2e:production": "playwright test -c playwright.production.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "typecheck": "tsc -b --pretty false",
        "preview": "vite preview"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-arabic": "^5.3.0",
        "@fontsource-variable/noto-sans-sc": "^5.3.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.5.11",
        "i18next-browser-languagedetector": "^8.3.0",
        "i18next-http-backend": "^4.0.10",
        "lucide-react": "^1.70.0",
        "prism-react-renderer": "^2.4.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9",
        "react-router": "^8.5.1",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17",
        "jsdom": "^31.0.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "pyodide": "314.0.7",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "typescript": "~6",
        "typescript-eslint": "^8",
        "vite": "^8.3.7",
        "vitest": "^5.1.0"
    }
}
