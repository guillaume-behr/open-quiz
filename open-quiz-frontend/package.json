{
    "name": "open-quiz-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.15.1",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"public/locales/*/translation.json\" \"*.{js,json,ts}\" \"index.html\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"public/locales/*/translation.json\" \"*.{js,json,ts}\" \"index.html\"",
        "test": "node scripts/check-locales.mjs",
        "typecheck": "tsc -b --pretty false",
        "preview": "vite preview"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/noto-sans-arabic": "^5.3.0",
        "@fontsource-variable/noto-sans-sc": "^5.3.0",
        "@tailwindcss/vite": "^4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.3.6",
        "i18next-browser-languagedetector": "^8.2.1",
        "i18next-http-backend": "^4.0.0",
        "lucide-react": "^1.25.0",
        "prism-react-renderer": "^2.4.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-i18next": "^17.0.10",
        "react-router": "^8.3.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6",
        "eslint": "^10",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "shadcn": "^4.13.1",
        "typescript": "~6",
        "typescript-eslint": "^8",
        "vite": "^8"
    }
}
