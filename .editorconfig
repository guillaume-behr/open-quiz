root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,js,mjs,ts,tsx,yaml,yml}]
indent_style = space
indent_size = 4

[*.{md,py}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# The layout `caddy fmt` enforces; Caddy warns at startup otherwise.
[Caddyfile]
indent_style = tab
