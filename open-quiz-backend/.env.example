DATABASE_URL=sqlite:///./open-quiz.db
JWT_SECRET=replace-with-a-long-random-value
TOTP_ENCRYPTION_KEY=replace-with-a-separate-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
QUIZ_JOIN_ATTEMPTS=20
QUIZ_PARTICIPANT_ATTEMPTS=240
QUIZ_VIOLATION_ATTEMPTS=20
QUIZ_RATE_WINDOW_SECONDS=60
QUIZ_RESULT_RETENTION_DAYS=365
MAX_REQUEST_BODY_BYTES=65536
APP_ENV=development
