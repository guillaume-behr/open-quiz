DATABASE_URL=postgresql+psycopg://open_quiz@127.0.0.1:5432/open_quiz
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-long-random-value
TOTP_ENCRYPTION_KEY=replace-with-a-separate-long-random-value
STUDENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-another-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
GLOBAL_LOGIN_ATTEMPTS=2000
GLOBAL_LOGIN_WINDOW_SECONDS=60
QUIZ_JOIN_ATTEMPTS=60
QUIZ_PARTICIPANT_ATTEMPTS=900
QUIZ_VIOLATION_ATTEMPTS=60
QUIZ_RATE_WINDOW_SECONDS=60
QUIZ_RESULT_RETENTION_DAYS=365
TRAINING_RESULT_RETENTION_DAYS=365
ABANDONED_SESSION_RETENTION_DAYS=7
PROBLEM_REPORT_ATTEMPTS=60
PROBLEM_REPORT_WINDOW_SECONDS=900
PROBLEM_REPORT_RETENTION_DAYS=90
MAX_REQUEST_BODY_BYTES=65536
APP_ENV=development

# Non-professional anonymous publication:
# only the host's identity and address are published. The publisher must give
# the host their real identification details outside this application.
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
# Use only institutional or functional contacts below, never a teacher's
# personal address. Replace each value with facts validated for the deployment.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_CONTACT=
PRIVACY_DPO_CONTACT=
PRIVACY_LEGAL_BASIS=
PRIVACY_RECIPIENTS=
PRIVACY_TEACHER_DATA_RETENTION=
PRIVACY_STUDENT_DATA_RETENTION=
PRIVACY_SECURITY_LOG_RETENTION=
ACCESSIBILITY_CONTACT=
ACCESSIBILITY_SCHEME_URL=
ACCESSIBILITY_ACTION_PLAN_URL=
