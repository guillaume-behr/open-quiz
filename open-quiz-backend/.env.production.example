DATABASE_URL=sqlite:////data/open-quiz.db
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters
TOTP_ENCRYPTION_KEY=replace-with-a-different-random-value-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-16-characters
FRONTEND_ORIGIN=https://quiz.example.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
GLOBAL_LOGIN_ATTEMPTS=500
GLOBAL_LOGIN_WINDOW_SECONDS=60
QUIZ_JOIN_ATTEMPTS=20
QUIZ_PARTICIPANT_ATTEMPTS=240
QUIZ_VIOLATION_ATTEMPTS=20
QUIZ_RATE_WINDOW_SECONDS=60
QUIZ_RESULT_RETENTION_DAYS=365
PROBLEM_REPORT_ATTEMPTS=5
PROBLEM_REPORT_WINDOW_SECONDS=900
PROBLEM_REPORT_RETENTION_DAYS=90
MAX_REQUEST_BODY_BYTES=65536
APP_ENV=production

# Non-professional anonymous publication:
# only the host's identity and address are published. The publisher must give
# the host their real identification details outside this application.
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
# Use only institutional or functional contacts below, never a teacher's
# personal address. Enter facts validated by the responsible institution/DPO.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_CONTACT=
PRIVACY_DPO_CONTACT=
PRIVACY_LEGAL_BASIS=
PRIVACY_RECIPIENTS=
PRIVACY_TEACHER_DATA_RETENTION=
PRIVACY_STUDENT_DATA_RETENTION=
PRIVACY_SECURITY_LOG_RETENTION=
ACCESSIBILITY_CONTACT=
ACCESSIBILITY_SCHEME_URL=
ACCESSIBILITY_ACTION_PLAN_URL=
