# Docker Compose settings of the deployment. Docker Compose reads them from a
# file named .env next to docker-compose.yml; install.sh creates it from this
# example. Keep them here rather than in the shell: update.sh, backup.sh and
# restore.sh must all see the same values. Every value below is the default.
# The API's own settings live in open-quiz-backend/.env.

# First three bytes of the private /24 network of the containers. Change it
# only if 172.28.0.0/24 is already used on the host.
OPEN_QUIZ_SUBNET_PREFIX=172.28.0

# Uvicorn worker processes of the API.
OPEN_QUIZ_API_WORKERS=1

# Processes and threads the API container may run: about
# 100 x OPEN_QUIZ_API_WORKERS + 64.
OPEN_QUIZ_API_PIDS=256

# Memory of the API and of the interface proxy (no swap on top).
OPEN_QUIZ_API_MEMORY=2g
OPEN_QUIZ_PROXY_MEMORY=512m

# Database backups kept in backups/ by update.sh, restore.sh and backup.sh
# (backup.sh --keep overrides it): older ones are deleted. Read by the
# scripts, not by Docker Compose.
OPEN_QUIZ_BACKUP_KEEP=14
